<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Akka.Cluster" Version="1.5.70" />
    <PackageVersion Include="Akka.Persistence.TestKit" Version="1.5.70" />
    <PackageVersion Include="Akka.Persistence.Query.InMemory" Version="1.5.70" />
    <PackageVersion Include="Akka.Remote.Hosting" Version="1.5.70" />
    <PackageVersion Include="Akka.TestKit.Xunit2" Version="1.5.70" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.9" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="8.6.0" />
    <PackageVersion Include="Akka.Persistence.Hosting" Version="1.5.70" />
    <PackageVersion Include="Akka.Cluster.Hosting" Version="1.5.70" />
    <PackageVersion Include="Akka.Persistence.Sql.Hosting" Version="1.5.70" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <!-- Akka.Persistence.Sql reaches Postgres through LinqToDB, which needs the provider assembly
         present to open a connection at all; without it every persistence call hangs rather than
         failing. Same pair the OrderFulfillment sample references. -->
    <PackageVersion Include="Npgsql" Version="9.0.3" />
    <PackageVersion Include="linq2db" Version="5.4.1.9" />
    <!-- Testcontainers 4.13.0 brings SSH.NET 2025.1.0 transitively, which carries
         GHSA-q939-rpr3-3284 (high). Pinned forward to the patched release; this is a test-only
         dependency and never reaches the Sagant packages, but the repo keeps its own build clean of
         known-vulnerable versions. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>
</Project>