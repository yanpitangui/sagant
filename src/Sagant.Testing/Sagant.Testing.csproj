<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Pure in-memory unit-testing harness for Sagant workflows — no ActorSystem, no
      persistence, no ClusterSharding. Drives a workflow's [WorkflowStep]/[WorkflowCommandHandler]
      logic directly and lets a Microsoft.Extensions.Time.Testing.FakeTimeProvider control pause- and
      workflow-level timeouts. Separate from Sagant itself so that package can stay free of any
      dependency on the testing-time package this one takes on.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sagant\Sagant.csproj" />
  </ItemGroup>

</Project>
